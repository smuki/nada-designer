{
  "name": "nada-designer-project",
  "version": "1.1.14",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm i && turbo run build -F nada-examples && turbo run build",
    "dev": "turbo run dev",
    "lib": "vitest run && turbo run build -F nada-designer",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "examples:build": "pnpm run build -F nada-examples",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "typecheck": "vue-tsc --noEmit -p typecheck.tsconfig.json",
    "postinstall": "pnpm -r run stub --if-present"
  },
  "dependencies": {
    "@vueuse/core": "catalog:"
  },
  "devDependencies": {
    "@nada-designer/base-ui": "workspace:*",
    "@nada-designer/core": "workspace:*",
    "@nada-designer/eslint-config": "workspace:*",
    "@nada-designer/hooks": "workspace:*",
    "@nada-designer/manager": "workspace:*",
    "@nada-designer/panel-ui": "workspace:*",
    "@nada-designer/scripts": "workspace:*",
    "@nada-designer/types": "workspace:*",
    "@nada-designer/utils": "workspace:*",
    "@turbo/gen": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "less": "catalog:",
    "nada-designer": "workspace:*",
    "nada-designer-antd": "workspace:*",
    "nada-designer-element-plus": "workspace:*",
    "nada-designer-naive-ui": "workspace:*",
    "nada-designer-tdesign": "workspace:*",
    "naive-ui": "catalog:",
    "tdesign-vue-next": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "packageManager": "pnpm@9.10.0"
}
