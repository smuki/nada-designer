{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "packages/core/src/**/*",
    "packages/hooks/src/**/*",
    "packages/manager/src/**/*",
    "packages/nada-designer/**/*",
    "packages/types/src/**/*",
    "packages/utils/src/**/*",
    "packages/ui-kit/base-ui/src/**/*",
    "packages/ui-kit/panel-ui/src/**/*",
    "packages/ui/antd/src/**/*",
    "packages/ui/elementPlus/src/**/*",
    "packages/ui/naiveUi/src/**/*",
    "packages/ui/tdesign/src/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/__test__/**",
    "**/*.test.ts",
    "**/vite.config.ts"
  ]
}
